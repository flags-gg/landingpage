:{$PORT:80} {
	root * /srv
	encode gzip zstd
	# ponytail: script-src needs 'unsafe-inline' for React Router's inline hydration scripts;
	# drop it once the build emits hashed scripts instead
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.flags.gg; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /__spa-fallback.html
	file_server
}
